# Copy to .env for local development.

# SQLite file location. The Docker image (Render) uses sqlite:////data/app.db.
DATABASE_URL=sqlite:///./app.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# Seed the database with demo meetings when it is empty.
SEED_ON_STARTUP=true

# Optional: free Groq API key (https://console.groq.com/keys) for LLM-written notes and AskFred.
# Leave empty to use the built-in summarizer and search-based AskFred.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
